{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagingos.local/schemas/prompt-benchmark-run-v1.json",
  "title": "StagingOS prompt benchmark run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "catalog_version",
    "catalog_sha256",
    "model_version",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "catalog_version": { "type": "string" },
    "catalog_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_version": { "type": "string" },
    "case_count": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "source_image_id",
          "source_path",
          "source_sha256",
          "room_type",
          "style_id",
          "variant_id",
          "variant_label",
          "prompt_ref",
          "seed",
          "prompt",
          "prompt_sha256"
        ]
      }
    }
  },
  "additionalProperties": true
}
