{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagingos.local/schemas/modern-arabic-prompt-catalog-v1.json",
  "title": "Modern Arabic prompt benchmark catalog",
  "type": "object",
  "required": [
    "living_room_prompts",
    "bedroom_prompts",
    "studio_prompts"
  ],
  "properties": {
    "living_room_prompts": { "$ref": "#/$defs/promptList" },
    "bedroom_prompts": { "$ref": "#/$defs/promptList" },
    "studio_prompts": { "$ref": "#/$defs/promptList" }
  },
  "additionalProperties": false,
  "$defs": {
    "promptList": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "style", "prompt"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "style": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  }
}
